POSTGRES_HOST=postgres16
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mydb
POSTGRES_PORT=5432
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=example@example.com
PGADMIN_DEFAULT_PASSWORD=changeme
API_SERVER_PORT=4000
API_SERVER_KEY=maplytics_secret_key
NEXT_PUBLIC_PORT=3000
#For production: NEXT_PUBLIC_API_URL=https://maplytics.org/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api
#Firebase Variables
NEXT_PUBLIC_FIREBASE_API_KEY=<firebase_api_key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<firebase_auth_domain>
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<firebase_project_id>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<firebase_storage_bucket>
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<firebase_sender_id>
NEXT_PUBLIC_FIREBASE_APP_ID=<firebase_app_id>
# Firebase Admin SDK 
FIREBASE_PROJECT_ID=<FIREBASE_PROJECT_ID>
FIREBASE_CLIENT_EMAIL=<FIREBASE_CLIENT_EMAIL>
FIREBASE_PRIVATE_KEY=<FIREBASE_PRIVATE_KEY>

# RustFS Variables
RUSTFS_PORT1=9000
RUSTFS_PORT2=9001
# S3 (Rustfs)
S3_REGION=us-east-1
S3_ENDPOINT=http://rustfs:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET_NAME=datasets

# LLM Service (LangGraph + LM Studio)
LLM_SERVICE_PORT=8000
# Use host.docker.internal from inside Docker to reach LM Studio on the host
PRIMARY_LLM_BASE_URL=http://host.docker.internal:1234/v1
PRIMARY_LLM_MODEL=qwen/qwen3.5-9b
PRIMARY_LLM_API_KEY=lm-studio
VERIFIER_LLM_BASE_URL=http://host.docker.internal:1234/v1
VERIFIER_LLM_MODEL=qwen/qwen3.5-9b
VERIFIER_LLM_API_KEY=lm-studio
MAX_FEATURES_IN_CONTEXT=200
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120
LLM_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_LLM_SERVICE_URL=http://localhost:8000